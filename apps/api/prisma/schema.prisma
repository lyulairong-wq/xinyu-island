generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String
  ageBand      String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  sessions     UserSession[]
  consents     ConsentRecord[]
  conversations Conversation[]
  privateContacts PrivateContact[]
  memories     ContactMemory[]
  defaultMemoryEnabled Boolean @default(false)
  tokenAccount TokenAccount?
  usageRecords TokenUsageRecord[]
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  deviceLabel  String?
  lastSeenAt   DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model ConsentRecord {
  id             String    @id @default(cuid())
  userId         String
  consentType    String
  documentVersion String
  granted        Boolean   @default(true)
  grantedAt      DateTime  @default(now())
  revokedAt      DateTime?
  source         String    @default("web")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@unique([userId, consentType, documentVersion])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  contactId String
  kind      String    @default("single")
  title     String?
  memoryEnabled Boolean @default(false)
  archivedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  members   ConversationMember[]

  @@index([userId, archivedAt, updatedAt])
}

model PrivateContact {
  id          String   @id @default(cuid())
  userId      String
  name        String
  tagline     String?
  description String?
  avatar      String?
  tone        String?
  persona     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ContactMemory {
  id         String   @id @default(cuid())
  userId     String
  contactId  String
  fact       String
  sensitivity String  @default("normal")
  source     String   @default("user_explicit")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, contactId, updatedAt])
}

model TokenAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  freeLimit   Int      @default(10000)
  freeUsed    Int      @default(0)
  freeResetAt DateTime
  paidBalance Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TokenUsageRecord {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  messageId      String?
  mode           String
  bucket         String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  source         String   @default("estimated")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  quotedMessageId String?
  role           String
  content        String
  mode           String       @default("free")
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  quotedMessage  Message?     @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedBy       Message[]    @relation("MessageQuote")

  @@index([conversationId, createdAt])
  @@index([quotedMessageId])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  contactId      String
  sortOrder      Int
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, contactId])
  @@index([conversationId, sortOrder])
}
