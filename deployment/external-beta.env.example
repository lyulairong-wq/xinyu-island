# Copy to a protected file outside the repository, then pass it with:
# docker compose --env-file /secure/path/xinyu-external-beta.env -f deployment/compose.external-beta.yml up -d --build
BETA_DOMAIN=beta.example.com
DATABASE_URL=postgresql://username:password@private-postgres-host:5432/xinyu?sslmode=require
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FREE_MODEL_API_KEY=replace-with-a-server-side-dashscope-key
FREE_MODEL_TIMEOUT_MS=30000
FREE_MAX_INPUT_CHARS=2000
FREE_MAX_OUTPUT_TOKENS=512
FREE_USER_COOLDOWN_MS=3000
